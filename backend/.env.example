DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/enquiry_management
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=28800
DATABASE_SSL=false
# Required only when importing db.json for the first time.
SEED_ADMIN_PASSWORD=ChangeMe1!
# Set temporarily only when running db:reset-super-admin, then remove it.
SUPER_ADMIN_IDENTIFIER=admin
RESET_ADMIN_PASSWORD=ReplaceWithANew1!
# Required in production to email password-reset links.
APP_URL=https://your-project.vercel.app
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=EnquiryDesk <no-reply@your-verified-domain.com>
