DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/enquiry_management
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=28800
DATABASE_SSL=false
# Required only when importing db.json for the first time.
SEED_ADMIN_PASSWORD=ChangeMe1!
# Set temporarily only when running db:reset-super-admin, then remove it.
SUPER_ADMIN_IDENTIFIER=admin
RESET_ADMIN_PASSWORD=ReplaceWithANew1!
# Required in production to email password-reset links over SMTP.
APP_URL=https://enquiry-management-api.vercel.app/
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_your_smtp_username
SMTP_PASSWORD=replace_with_your_smtp_password
EMAIL_FROM=EnquiryDesk <no-reply@enquirydesk.com>
