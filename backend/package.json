{
  "name": "inquiry-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vercel-build": "npm run typecheck",
    "start": "node --env-file-if-exists=.env server/api.ts",
    "dev": "node --env-file-if-exists=.env --watch server/api.ts",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env server/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test tests/security.test.mjs",
    "test:integration": "node tests/backend-smoke.mjs"
  },
  "dependencies": { "pg": "^8.23.1" },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.2"
  },
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" }
}
