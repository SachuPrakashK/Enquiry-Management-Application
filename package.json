{
  "name": "enquiry-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run typecheck:api && npm run test:api && npm run test:e2e",
    "start:app": "ng serve --proxy-config proxy.conf.json",
    "start:api": "node server/api.ts",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck:api": "tsc -p tsconfig.server.json"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.8",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
