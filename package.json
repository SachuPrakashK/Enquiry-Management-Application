{
  "name": "inquiry-management-application",
  "private": true,
  "packageManager": "npm@12.0.1",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run build --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" }
}
