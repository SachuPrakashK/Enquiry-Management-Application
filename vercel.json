{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ]
}
